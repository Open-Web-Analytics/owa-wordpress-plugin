{
    "name": "open-web-analytics/owa-wordpress-plugin",
    "description": "WordPress plugin for Open Web Analytics.",
    "keywords": ["open-web-analytics","owa","web-analytics","analytics", "WordPress"],
    "homepage": "https://www.openwebanalytics.com",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "The OWA Team",
            "email": "hello@openwebanalytics.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "require": {
        "php": ">=8.2",
        "open-web-analytics/owa-php-sdk": "^1.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "owaWp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "owaWp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find owa-plugin.php src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit"
    }
}
